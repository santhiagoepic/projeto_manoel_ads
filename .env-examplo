GEMINI_API_KEY=PLACEHOLDER_API_KEY

# Credenciais do painel admin (seed no SQLite na primeira execução)
ADMIN_EMAIL=admin@fpdr.com
ADMIN_PASSWORD=admin123

# Porta do servidor local (API + SQLite)
API_PORT=8787

# Produção (Swarm + Traefik)
# Domínio do FRONTEND (web)
FRONT_DOMAIN=advmanoelneto.com.br

# Domínio da API (backend)
API_DOMAIN=api.advmanoelneto.com.br

# (Opcional) Traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencryptresolver
